<%- include('../partials/header.ejs') %>
<main>
    <div class="item-detail">
        <div class="image">
            <img src="<%=item.image%>" alt="item.title">
        </div>
        <div class="details">
            <h2><%=item.title%></h2>
            <p><%=item.details%></p>
            <p>Condition: <%=item.condition%></p>
            <p>Price: $<%=item.price%></p>
            <p>Seller: <%=item.seller.firstName + ' ' + item.seller.lastName%></p>
            <p>Offers Received: <%= item.totalOffers%></p>
            <% if (item.active && item.totalOffers > 0) { %>
                <p>Highest Offer: $<%= item.highestOffer.toFixed(2) %></p>
            <% } %>
            <% if(!item.active) { %><p class = "red">Unfortunately, this item is no longer available.</p><% } %>
            <% if (item.active) { %>
                <form action="/items/<%= item._id %>/offers" method="POST">
                    <label for="amount">Make an Offer:</label>
                    <input type="number" name="amount" step="0.01" required>
                    <button type="submit">Submit Offer</button>
                </form>            <% } %>
            </div>
    </div>
</main>
<%- include('../partials/footer.ejs') %>

